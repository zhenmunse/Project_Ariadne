{
  "aggregation": {
    "cost_conditioning": "valid_runs_only",
    "order": [
      "within_target_runs",
      "equal_weight_across_targets"
    ],
    "target_weighting": "equal",
    "validity_denominator": "all_requested_runs"
  },
  "conditions": [
    "zero",
    "full"
  ],
  "models": {
    "closed_frontier": {
      "logical_condition_ids": {
        "full": "gpt56_sol_full",
        "zero": "gpt56_sol_zero"
      },
      "max_output_tokens": 32768,
      "api_key_env": "OPENAI_API_KEY",
      "endpoint": "https://api.openai.com/v1/responses",
      "model_id_status": "smoke_verified",
      "multi_agent": false,
      "provider": "closed_frontier",
      "reasoning": "medium",
      "requested_model_id": "gpt-5.6-sol",
      "temperature": null,
      "top_p": null
    },
    "open_weight": {
      "logical_condition_ids": {
        "full": "deepseek_v4_full",
        "zero": "deepseek_v4_zero"
      },
      "max_output_tokens": 32768,
      "api_key_env": "DEEPSEEK_API_KEY",
      "endpoint": "https://api.deepseek.com/chat/completions",
      "model_id_status": "smoke_verified",
      "provider": "open_weight",
      "reasoning": "medium",
      "requested_model_id": "deepseek-v4-pro",
      "thinking_enabled": true,
      "temperature": null,
      "top_p": null,
      "smoke_verification": {
        "mode": "inherited_nonbinding_ceiling_increase",
        "source_max_output_tokens": 16384,
        "reason": "medium-effort target-6 and target-39 pilots ended naturally with finish_reason=stop; raising only the hard ceiling cannot truncate those completed responses"
      }
    }
  },
  "parser_policy": {
    "allowed_normalizations": [
      "trim_outer_whitespace",
      "remove_single_outer_markdown_code_fence"
    ],
    "exact_root_fields": [
      "sequence"
    ],
    "repair": false
  },
  "provider_response_provenance_required": [
    "requested_model_id",
    "response_model_id",
    "provider_request_id",
    "created_at_utc",
    "finish_reason",
    "input_tokens",
    "output_tokens",
    "reasoning_tokens",
    "latency_seconds",
    "raw_provider_payload"
  ],
  "repetitions": 20,
  "request_policy": {
    "automatic_retry_after_valid_response": false,
    "code_execution": false,
    "conversation_memory": false,
    "experimental_retry_after_provider_response": false,
    "fresh_request": true,
    "previous_response": false,
    "repair_invalid_output": false,
    "retrieval": false,
    "search": false,
    "single_turn": true,
    "tools": false,
    "transport_retry": {
      "allowed_before_provider_response": true,
      "logical_run_id_preserved": true,
      "max_attempts": 3,
      "record_every_attempt": true
    }
  },
  "schema_version": 1,
  "targets_from_manifest": true
}
